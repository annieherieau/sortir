{% extends 'base.html.twig' %}

{% block title %}
    {{ titre }}
{% endblock %}

{% block main %}
    <h2>{{ titre }}</h2>
    {{ form_start(sortieForm) }}

    {{ form_widget(sortieForm) }}

    <input type="submit" class="btn btn-primary" value="Enregistrer" id="submit-enregistrer">
{#    <input type="submit" class="btn btn-dark" value="Publier" id="submit-publier">#}
    <a class="btn btn-outline-primary" href="{{ path('sortie_index') }}">Retour à la liste</a>
    {{ form_end(sortieForm) }}

    <script type="text/javascript" src="{{ asset('js/sortie-form.js') }}"></script>
{% endblock %}

